{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QingqiuhuWorkbench",
  "version": "4.0.0-alpha.8",
  "identifier": "net.qingqiuhu.workbench",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "青丘湖网络工作台",
        "width": 1500,
        "height": 940,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
